{
  "name": "chatgyan-backend",
  "version": "1.0.0",
  "description": "The backend application for the project ChatGyan, a real-time chat application built using the MERN stack and Socket.IO.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "pnpm run lint && tsc --build tsconfig.json && tsc-alias",
    "clean-install": "rm -rf ./node_modules && rm -r pnpm-lock.yaml && pnpm install",
    "dev": "cross-env NODE_ENV=development tsx --env-file=./config/.env.development src/index.ts",
    "dev:hot": "nodemon --exec \"pnpm run dev\" --watch ./src --ext .ts",
    "lint": "eslint .",
    "start": "cross-env NODE_ENV=production node --env-file=./config/.env.production ./dist",
    "phantom-start": "cross-env NODE_ENV=production node ./dist",
    "test": "cross-env NODE_ENV=test vitest",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Sumit Chaurasiya",
  "license": "ISC",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie": "^2.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
