{
  "name": "chatgyan-backend",
  "version": "1.0.0",
  "description": "The backend application for the project ChatGyan, a real-time chat application built using the MERN stack and Socket.IO.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "clean": "node --eval \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "dev": "cross-env NODE_ENV=development tsx watch --env-file=./config/.env.development src/index.ts",
    "build": "pnpm lint && pnpm build:no-lint",
    "build:no-lint": "tsc --build tsconfig.json && tsc-alias",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_ENV=production node --env-file=./config/.env.production ./dist/index.js",
    "start:no-env": "cross-env NODE_ENV=production node ./dist/index.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "keywords": [],
  "author": "Sumit Chaurasiya",
  "license": "ISC",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "morgan": "^1.11.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "globals": "^17.7.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
